# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit real secrets/keys
.env
.env.local
.env.*.local
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# testing
coverage/

# editor
.vscode/*
!.vscode/extensions.json

# Image-provider benchmark — private source portraits, generated outputs,
# and the local Replicate token must never be committed.
benchmarks/image-providers/.env
benchmarks/image-providers/.env.local
benchmarks/image-providers/inputs/*
!benchmarks/image-providers/inputs/.gitkeep
benchmarks/image-providers/outputs/*
!benchmarks/image-providers/outputs/.gitkeep

# Local research, source archives, and scratch material are not build inputs.
/benchmarks/
/Claude outputs/
/Images/
/_to_delete/
/*.zip
/*.patch
/*.bundle
/ backup-before-reconciled-import
/tatus