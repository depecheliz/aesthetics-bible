# Copy this file to .env.local and fill in real values for local development.
# Only variables prefixed EXPO_PUBLIC_ are safe here — they are bundled into
# the client. Never put service-role keys, AI provider secrets, RevenueCat
# secret keys, Google server keys, or any other private credential in this
# file or in any EXPO_PUBLIC_ variable.

EXPO_PUBLIC_APP_ENV=development

# Supabase (client-safe public keys only)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (public SDK keys only)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Google Places (restricted client key only)
EXPO_PUBLIC_GOOGLE_PLACES_CLIENT_KEY=

# Analytics (public write key only)
EXPO_PUBLIC_ANALYTICS_WRITE_KEY=
